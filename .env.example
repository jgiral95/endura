# Plantilla local. No incluir secretos reales en Git.
POSTGRES_DB=endura
POSTGRES_USER=endura
# La contraseña se inserta en DATABASE_URL desde compose.yaml; usa un valor URL-safe.
POSTGRES_PASSWORD=REPLACE_WITH_URL_SAFE_PASSWORD
SESSION_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
APP_PORT=8086
# Solo para probar en http://localhost sin HTTPS. En el servidor detrás de Cloudflare déjalo en true.
COOKIE_SECURE=true
